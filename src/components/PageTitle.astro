---
import HomeSearch from './HomeSearch.astro';

const { entry } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
const isHomePage = title === 'Центр знаний Spread Insight';

const sectionLabels: Record<string, string> = {
  community: 'Сообщество',
  concepts: 'Понятия и расчёты',
  'getting-started': 'С чего начать',
  literature: 'Литература',
  strategies: 'Стратегии и торговые идеи',
  technique: 'Техника',
  tools: 'Инструменты',
  webinars: 'Вебинары',
  'whats-new': 'Что нового',
};

const section = sectionLabels[entry.id.split('/')[0]];
const descriptionParts = description
  ?.split('·')
  .map((part) => part.trim())
  .filter(Boolean) ?? [];
const isCompactMeta = (value: string) =>
  /^(?:~?\s*\d+\s*(?:мин|ч)|\d+\s+видео$|видео$)/i.test(value);

let eyebrow = section;
let details: string[] = [];
let summary: string | undefined;

if (descriptionParts.length > 1) {
  if (descriptionParts[0]?.toLocaleLowerCase('ru') === 'вебинар') {
    eyebrow = descriptionParts[0];
    details = descriptionParts.slice(1);
  } else {
    const metaIndex = descriptionParts.findIndex(
      (part, index) => index > 0 && isCompactMeta(part),
    );

    if (metaIndex > 0) {
      eyebrow = descriptionParts[metaIndex - 1];
      details = descriptionParts.slice(metaIndex);
    } else {
      summary = description;
    }
  }
} else if (description && description !== section) {
  summary = description;
}
---

{
  isHomePage ? (
    <header class="si-home-hero">
      <h1 id="_top">{title}</h1>
      {description && <p class="si-home-hero__summary">{description}</p>}
      <HomeSearch />
      <div class="si-home-hero__actions">
        <a class="si-home-hero__action si-home-hero__action--primary" href="/getting-started/what-is-spread-insight/">
          Начать знакомство
        </a>
        <a
          class="si-home-hero__action"
          href="https://spread-i.online/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Открыть Spread Insight <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
  ) : (
    <header class="si-article-header">
      {eyebrow && <p class="si-article-header__eyebrow">{eyebrow}</p>}
      <h1 id="_top">{title}</h1>
      {summary && <p class="si-article-header__summary">{summary}</p>}
      {details.length > 0 && (
        <p class="si-article-header__details">
          {details.map((detail) => <span>{detail}</span>)}
        </p>
      )}
    </header>
  )
}
